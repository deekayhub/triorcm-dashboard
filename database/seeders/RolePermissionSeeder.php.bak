<?php

namespace Database\Seeders;

use App\Models\User;
use Illuminate\Database\Seeder;
use Spatie\Permission\Models\Permission;
use Spatie\Permission\Models\Role;
use Spatie\Permission\PermissionRegistrar;

class RolePermissionSeeder extends Seeder
{
    /**
     * @var list<string>
     */
    private array = [
        'dashboard.view',
        'dashboard.export',
        'reports.view',
        'users.view',
        'users.create',
        'users.update',
        'users.delete',
        'roles.view',
        'roles.manage',
        'settings.manage',
    ];

    /**
     * @var array<string, list<string>>
     */
    private array \ = [
        'super-admin' => [
            'dashboard.view',
            'dashboard.export',
            'reports.view',
            'users.view',
            'users.create',
            'users.update',
            'users.delete',
            'roles.view',
            'roles.manage',
            'settings.manage',
        ],
        'admin' => [
            'dashboard.view',
            'dashboard.export',
            'reports.view',
            'users.view',
            'users.create',
            'users.update',
            'users.delete',
            'roles.view',
            'roles.manage',
            'settings.manage',
        ],
        'manager' => [
            'dashboard.view',
            'dashboard.export',
            'reports.view',
            'users.view',
            'users.update',
        ],
        'viewer' => [
            'dashboard.view',
            'reports.view',
        ],
    ];

    public function run(): void
    {
        app(PermissionRegistrar::class)->forgetCachedPermissions();

        foreach (\->permissions as \) {
            Permission::findOrCreate(\, 'web');
        }

        app(PermissionRegistrar::class)->forgetCachedPermissions();

        foreach (\->roles as \ => \) {
            \ = Role::findOrCreate(\, 'web');
            \->syncPermissions(\);
        }

        if (! User::query()->whereHas('roles')->exists()) {
            \ = User::query()->orderBy('id')->get();

            \->first()?->assignRole('super-admin');
            \->skip(1)->each(fn (User \) => \->assignRole('viewer'));
        }

        app(PermissionRegistrar::class)->forgetCachedPermissions();
    }
}

